# Kopiere diese Datei nach .env und passe die Werte an.

# Zugangsdaten für das Webinterface selbst (nicht die Apple-ID!)
APP_USERNAME=admin
APP_PASSWORD=bitte-aendern

# Optional: fester Schluessel zur Verschluesselung des gespeicherten
# Apple-ID-Passworts. Wird nicht gesetzt -> automatisch generiert und unter
# /data/config/secret.key persistiert.
# FERNET_KEY=

TZ=Europe/Berlin
